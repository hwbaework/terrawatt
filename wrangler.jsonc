// Cloudflare Workers(정적 에셋) 배포 설정 — `npm run deploy` 또는 대시보드 Git 연동에서 사용
{
  "name": "terrawatt",
  "compatibility_date": "2026-07-01",
  // /umei-api/* 만 워커가 받아 API 키(시크릿 UMEI_API_KEY)를 붙여 UMEI 로 넘긴다. 나머지는 정적 에셋 그대로
  // 키 등록: npx wrangler secret put UMEI_API_KEY
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/umei-api/*"]
  }
}
